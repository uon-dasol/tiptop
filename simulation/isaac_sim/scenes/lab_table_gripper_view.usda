#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (-3.0683715587779963, 0.09626901980653778, 0.44596854336827607)
                double3 target = (15.613071247384465, 5.420505376735913, 1.9504797971364296)
            }
            dictionary Right = {
                double3 position = (-1.025579472613159, -5, 1.2196080214859188)
                double radius = 5.260945510864258
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./lab_table_gripper_view.usda"
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    doc = "Lab table draft: world axes match robot base_link. X width 78 cm, Y length 250 cm; Y sections 80.5 / 89 / 80.5 cm. Provisional thickness 3 cm. Robot mounting face and tabletop are Z=0; cable side is -Y. Layout preview only."
    metersPerUnit = 1
    subLayers = [
        @lab_table_keepout.usda@
    ]
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Table" (
        displayName = "Table X 78 cm x Y 250 cm"
    )
    {
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

        def Cube "Left" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
            displayName = "Negative Y section: X 78 cm x Y 80.5 cm"
        )
        {
            color3f[] primvars:displayColor = [(0.58, 0.48, 0.36)]
            double size = 1
            double3 xformOp:scale = (0.78, 0.805, 0.03)
            double3 xformOp:translate = (0, -0.8475, -0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Center" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
            displayName = "Center: X 78 cm x Y 89 cm - robot mounting surface"
        )
        {
            color3f[] primvars:displayColor = [(0.68, 0.58, 0.44)]
            double size = 1
            double3 xformOp:scale = (0.78, 0.89, 0.03)
            double3 xformOp:translate = (0, 0, -0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Right" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
            displayName = "Positive Y section: X 78 cm x Y 80.5 cm"
        )
        {
            color3f[] primvars:displayColor = [(0.58, 0.48, 0.36)]
            double size = 1
            double3 xformOp:scale = (0.78, 0.805, 0.03)
            double3 xformOp:translate = (0, 0.8475, -0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

