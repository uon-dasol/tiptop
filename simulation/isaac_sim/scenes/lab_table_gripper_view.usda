                vector3f physics:velocity = (0, 0, 0)
                quatd xformOp:orient = (-0.7062839576603601, 0.02288504689374372, 0.7068083880610007, 0.03257527201574225)
                double3 xformOp:translate = (-0.03439444303512573, 0.0026969462633132935, 0.1525000035762787)

                over "collisions"
                {
